script = ExtResource("1")
metadata/population_label = "Кабаны"
species_id = &"sus_scrofa"
display_name = "Кабан"
latin_name = "Sus scrofa"
description = "Крупный лесной всеядный зверь: плотное тело, вытянутое рыло, клыки и щетина. Ест конечные плоды, растительный корм, насекомых и падаль; при наземной кормёжке оставляет зарастающие порои и повреждает низкий покров. Корни не имеют отдельного пищевого запаса; стада, грязевые ванны и анатомическая походка пока не моделируются. Обмен и скорости сценарные."
