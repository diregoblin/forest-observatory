metadata/population_label = "Полёвки"
species_id = &"myodes_glareolus"
display_name = "Рыжая полёвка"
latin_name = "Myodes glareolus"
description = "Мелкий лесной грызун с округлыми ушами, рыжей спиной и коротким хвостом. Здесь ест местные растения, прячется и служит мелкой добычей лисы. Всеядность, семенной рацион теперь связаны с устойчивым местным убежищем; детали подземных ходов не моделируются; размеры и обмен сценарные."
